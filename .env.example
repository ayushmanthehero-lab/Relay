# Standalone AgentMemory owns FalkorDB 6381. Shared dev server can use 6380.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6381
DEMO_MODE=true
# demo is a labeled deterministic sample; live modes never silently fall back.
MODEL_PROVIDER=demo
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT=90
CODEX_COMMAND=codex
# Before hosting: DEMO_MODE=false, set your own secret and tokens.
APP_SECRET=replace-before-hosting
# Server owns identities; JSON object maps secrets to {id,name,tenant}.
AUTH_TOKENS_JSON={}
SUPPORT_WORKER_ENABLED=true
SUPPORT_WORKER_CONCURRENCY=3
SUPPORT_WORKER_INTERVAL=2
SUPPORT_MAX_ATTEMPTS=3
# Live Graphiti extraction uses the chosen model provider; demo labels indexing as inactive.
GRAPHITI_ENABLED=true
GRAPHITI_MAX_COROUTINES=2
GRAPHITI_MAX_ATTEMPTS=3
# Local CPU embeddings require a one-time model download; no additional API key.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=data/embedding-models
# Optional directory containing the same model's verified ONNX/tokenizer files.
EMBEDDING_LOCAL_PATH=
# For API/Ollama embeddings, select that backend and its own model/dimension/endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
